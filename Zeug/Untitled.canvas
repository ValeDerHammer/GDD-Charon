		{"id":"f87c0c56b58bbec2","type":"text","text":"haben nicht abgeschlossene Probleme, die sie nicht in den Tod übergehen lassen","x":-589,"y":-2161,"width":250,"height":85},
		{"id":"05b3c6f380de7d6a","x":-412,"y":-2036,"width":250,"height":60,"type":"text","text":"Seelen kennen sich manchmal untereinander"},
		{"id":"f95d67bd57671d6b","x":-255,"y":-1938,"width":250,"height":60,"type":"text","text":"im Game als kleiner ballförmiger Begleiter"},
