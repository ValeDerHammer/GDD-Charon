		{"id":"1bf7c9476d21745c","type":"text","text":"Special Attacken / Buffs\n\n- Range Attacke\n- Teleportation\n- Dodge Mechaniken\n- Wände hochklettern\n- Gravitation umkehren\n- Fliegen","x":-490,"y":-533,"width":250,"height":232},
		{"id":"ea3d25931a16503f","x":-560,"y":-711,"width":250,"height":85,"type":"text","text":"Seelen wegstoßen und herziehen und damit Gegnern Schaden zufügen"},
