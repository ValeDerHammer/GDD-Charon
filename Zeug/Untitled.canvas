		{"id":"69e77c9e80ac5fb1","x":-998,"y":-2800,"width":250,"height":60,"type":"text","text":"Maniac Kind"},
		{"id":"378efb928b78777d","type":"text","text":"Fährenmann, der seine Zulassung als Fährenmann durch die Unterwelt  erlangen möchte und unterschiedliche Seelen durch Level führt. Jede Seele eigene kleine Story mit Problemen, unterschiedliche gestaltet","x":445,"y":-2220,"width":281,"height":202},
		{"id":"d87e671d1b1d9600","x":336,"y":-2470,"width":459,"height":50,"type":"text","text":"Playable: Fährenmann"},
		{"id":"343a8453d86f733f","x":812,"y":-722,"width":250,"height":85,"type":"text","text":"Punkte im Level an denen vertiefender Dialog mit den Seelen möglich wird"},
